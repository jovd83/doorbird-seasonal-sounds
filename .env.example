# Copy to .env, fill in, then `docker compose up -d`.

# --- Web UI login -----------------------------------------------------
ADMIN_USERNAME=admin

# Preferred: a password hash, so no plaintext password sits in your
# environment or shows up in `docker inspect`. Generate one with:
#   python -m app.hash_password
ADMIN_PASSWORD_HASH=

# Or, for a simpler setup, a plaintext password. It is hashed in memory at
# startup, so it is never compared as plaintext -- but it is still readable
# in the environment. The app refuses to start if you leave the placeholder.
ADMIN_PASSWORD=change-me-please

# Session signing key  (python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=replace-with-48-byte-urlsafe-token

# Mark the session cookie `Secure`. Leave at 0 for the usual plain-HTTP LAN
# setup; set to 1 if you terminate TLS at a reverse proxy, or the cookie will
# be sent over plain HTTP too.
SESSION_HTTPS_ONLY=0

# How long a sign-in lasts, in seconds. Default is one week.
SESSION_MAX_AGE_SECONDS=604800

# Symmetric key for encrypting DoorBird device passwords at rest in SQLite
# (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
FERNET_KEY=replace-with-fernet-key

# --- Housekeeping -----------------------------------------------------
# Time of the daily reconciliation run (24h local time)
DAILY_RUN_HOUR=3
DAILY_RUN_MINUTE=15

# How long audit rows are kept, in days. The daily run prunes anything older.
# 0 keeps everything for ever -- which is what the app used to do, and why the
# table grew without limit on a busy front door.
AUDIT_RETENTION_DAYS=365

# Largest MP3 the upload forms accept, in bytes. Door chimes are a few seconds
# long; this is a guard against a mistyped file, not a quality setting.
MAX_UPLOAD_BYTES=2097152

# --- Ring-chime mode --------------------------------------------------
# Watch each device's monitor.cgi stream and play today's MP3 out of the
# door station's own speaker when the bell is pressed. This is the mode
# that works against the published LAN API. Set to 0 to disable.
RING_CHIME_ENABLED=1

# Ignore repeat rings within this many seconds (stops a held button from
# re-triggering the chime on top of itself).
RING_DEBOUNCE_SECONDS=8

# Hard cap on chime length; longer MP3s are truncated during transcode.
CHIME_MAX_SECONDS=15

# Gain trim applied before mu-law encoding. The door speaker is small and
# telephone-band, so a few dB often helps. 0 = untouched.
CHIME_GAIN_DB=0

# Also attempt the undocumented customsound.cgi upload. Off by default:
# that endpoint refuses everything except the factory administration user.
BUTTON_SOUND_UPLOAD_ENABLED=0

# Expose FastAPI's interactive docs at /docs and /openapi.json. These need no
# login and list every route, so they are off by default.
ENABLE_API_DOCS=0
